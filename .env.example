# Copy to .env and fill in. NEVER commit .env.
ATLAS_ENV=dev
ATLAS_LOG_LEVEL=INFO

# --- secrets (change all of these) -----------------------------------------
POSTGRES_PASSWORD=atlas
ATLAS_APP_DB_PASSWORD=atlas_app
MINIO_ROOT_USER=atlas
MINIO_ROOT_PASSWORD=atlas-secret
ATLAS_BOOTSTRAP_TOKEN=change-me-bootstrap
ATLAS_GATEWAY_INTERNAL_KEY=change-me-internal

# --- LLM providers (any subset; with none, everything runs on the mock LLM) --
ATLAS_ANTHROPIC_API_KEY=
ATLAS_OPENAI_API_KEY=
ATLAS_GEMINI_API_KEY=
ATLAS_XAI_API_KEY=
# set to 1 when running with --profile ollama
ATLAS_OLLAMA_ENABLED=
ATLAS_OLLAMA_MODEL=llama3.2

# --- models ---------------------------------------------------------------
ATLAS_EMBED_MODEL=BAAI/bge-small-en-v1.5
ATLAS_EMBED_DIM=384
ATLAS_RERANK_MODEL=BAAI/bge-reranker-base

# --- ingestion ------------------------------------------------------------
ATLAS_PARSER=native            # native | docling (build with WITH_DOCLING=1)
WITH_DOCLING=0
ATLAS_CONTEXTUAL_ENRICHMENT=true

# --- telemetry (point at Lumen or the observability profile's collector) --
ATLAS_OTLP_ENDPOINT=

# --- MCP server (create a read-scoped key after bootstrap) -----------------
ATLAS_MCP_API_KEY=
ATLAS_MCP_COLLECTIONS=
