;b&gt;Adding knowledge: from file to searchable&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="2. -user-22" value="&lt;b&gt;Create collection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;e.g. HR handbook&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#14332e;strokeColor=#2fbfa5;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -up-23" value="&lt;b&gt;Upload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;file, web page or text&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="255" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -same-24" value="&lt;b&gt;Seen before?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#2b2818;strokeColor=#a08a3c;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="482" y="178" width="150" height="80" as="geometry"/></mxCell><mxCell id="2. -skip-25" value="&lt;b&gt;Nothing to do&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;unchanged = free&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1d2b1d;strokeColor=#4f8a4f;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="350.0" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -proc-26" value="&lt;b&gt;Processing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;read → split → index&lt;/font&