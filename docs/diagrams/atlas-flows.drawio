/><mxCell id="4. -ftitle-57" value="&lt;font color=&quot;#f2f2f2&quot;&gt;&lt;b&gt;Deep research: a report instead of an answer&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="4. -q-58" value="&lt;b&gt;Ask a big question&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;+ effort: low / med / high&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#14332e;strokeColor=#2fbfa5;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="4. -plan-59" value="&lt;b&gt;Plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;outline + sub-questions&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="255" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="4. -r-60" value="&lt;b&gt;Research in parallel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;one helper per sub-question&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="4. -w-61" value="&lt;b&gt;Write report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;only from found evidence&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="4. -rev-62" value="&lt;b&gt;Review&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#2b2818;strokeColor=#a08a3c;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="912" y="178" width="150" height="80" as="geometry"/></mxCell><mxCell id="4. -done-63" value="&lt;b&gt;Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;sections + citations&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1d2b1d;strokeColor=#4f8a4f;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="4. -part-64" value="&lt;b&gt;Partial report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;budget reached, clearly marked&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2b2020;strokeColor=#8a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="330.0" width="175" height="56" as="geometry"/></mxCell><mxCell id="4. -fe-65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="4. -q-58" target="4. -plan-59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4. -fe-66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="4. -plan-59" target="4. -r-60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4. -fe-67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;end