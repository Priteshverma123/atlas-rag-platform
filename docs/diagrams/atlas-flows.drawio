<mxfile host="diagrams-as-code" agent="portfolio-tools" version="24.0.0"><diagram id="page-0" name="1. Question → answer"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" background="#121212"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1. -ftitle-2" value="&lt;font color=&quot;#f2f2f2&quot;&gt;&lt;b&gt;What a question looks like end to end&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="1. -ask-3" value="&lt;b&gt;Ask a question&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;chat, API or MCP&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#14332e;strokeColor=#2fbfa5;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="1. -mem-4" value="&lt;b&gt;Recall context&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;recent turns + user facts&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="255" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="1. -plan-5" value="&lt;b&gt;Understand question&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;rewrite, pick strategy&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="1. -find-6" value="&lt;b&gt;Find evidence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;keyword + meaning search&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="1. -enough-7" value="&lt;b&gt;Enough evidence?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#2b2818;strokeColor=#a08a3c;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="912" y="178" width="150" height="80" as="geometry"/></mxCell><mxCell id="1. -none-8" value="&lt;b&gt;Say &quot;not found&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;no LLM call, no cost&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2b2020;strokeColor=#8a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="350.0" width="175" height="56" as="geometry"/></mxCell><mxCell id="1. -write-9" value="&lt;b&gt;Write answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;every fact cites a source&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="90" width="175" height="56" as="geometry"/></mxCell><mxCell id="1. -check-10" value="&lt;b&gt;Check citations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;flag weak claims&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="220.0" width=