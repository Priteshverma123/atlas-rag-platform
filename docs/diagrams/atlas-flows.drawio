ue="&lt;b&gt;Ask&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="255" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="3. -stream-43" value="&lt;b&gt;Answer streams in&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;with numbered sources&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="3. -cite-44" value="&lt;b&gt;Click a source&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;PDF opens at the passage&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="90" width="175" height="56" as="geometry"/></mxCell><mxCell id="3. -follow-45" value="&lt;b&gt;Ask a follow-up&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;&quot;and for Tokyo?&quot;&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="3. -rate-46" value="&lt;b&gt;Rate the answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;👍 / 👎 / correction&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="290" width="175" height="56" as="geometry"/></mxCell><mxCell id="3. -memory-47" value="&lt;b&gt;Remembers context&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;earlier turns + preferences&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="3. -evalset-48" value="&lt;b&gt;Improves test set&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;bad answers become tests&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1d2b1d;strokeColor=#4f8a4f;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="290" width="175" height="56" as="geometry"/></mxCell><mxCell id="3. -fe-49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="3. -open-41" target="3. -ask-42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3. -fe-50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="3. -ask-42" target="3. -stream-43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3. -fe-51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="3. -stream-43" target="3. -cite-44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3. -fe-52" value="" style="edgeStyle=orthogonalEdgeStyle;rou