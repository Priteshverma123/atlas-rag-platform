udget (p95)&lt;/b&gt;&lt;br&gt;memory load 10 ms · router 250 ms · rewrite 250 ms&lt;br&gt;retrieval 80 ms · rerank 120 ms · TTFT 800 ms" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="100" width="300" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-4" name="5. Memory"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5. -title-181" value="&lt;b&gt;Memory: three tiers with provenance&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="5. -subtitle-182" value="ADD-only extraction (cheap, no destructive writes in the hot path) + background consolidation that supersedes stale facts bi-temporally." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="24" as="geometry"/></mxCell><mxCell id="5. -t1-183" value="Tier 1: Working memory (per conversation)" style="rounded=1;arcSize=3;fillColor=#f9fbff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;html=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="460" height="230" as="geometry"/></mxCell><mxCell id="5. -buf-184" value="Token-bounded message buffer&lt;br&gt;(last N turns ≤ budget)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="5. -t1-183"><mxGeometry x="20" y="40" width="200" height="60" as="geometry"/></mxCell><mxCell 