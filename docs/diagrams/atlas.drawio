eway: request pipeline&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="2. -subtitle-69" value="Portkey-style nested strategy tree + LiteLLM-style per-error retry policy &amp; cooldowns (state in Redis). Spend logs are never written in the request path." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="24" as="geometry"/></mxCell><mxCell id="2. -in-70" value="POST /v1/chat/completions" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="260" height="50" as="geometry"/></mxCell><mxCell id="2. -auth-71" value="Authenticate virtual key → tenant, user, route" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="165" width="260" height="50" as="geometry"/></mxCell><mxCell id="2. -rl-72" value="Token-bucket check (RPM + estimated TPM)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="240" width="260" height="80" as="geometry"/></mxCell><mxCell id="2. -bud-73" value="Budget check (key → user → tenant)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="345" width="260" height="80" as="geometry"/></mxCell><mxCell id="2. -ex-74" value="Exact cache lookup (sha256 canonical request)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="450" width="260" height="80" as="geometry"/></mxCell><mxCell id="2. -sem-75" value="Semantic cache lookup (if route enabled,&lt;br&gt;≤ 4 msgs, no tools)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="555" width="260" height="80" as="geometry"/></mxCell><mxCell id="2. -plan-76" value="Resolve strategy tree&lt;br&gt;fallback → loadbalance → targets" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="660" width="260" height="50" as="geometry"/></mxCell><mxCell id="2. -cool-77" value="Skip targets in cooldown" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="735" width="260" height="50" as="geometry"/></mxCell><mxCell id="2. -call-78" value="Provider adapter call&lt;br&gt;(TTFT timeout, streaming)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="810" width="260" height="50" as="geometry"/></mxCell><mxCell id="2. -err-79" value="Classify error" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="885" width="260" height="80" as="geometry"/></mxCell><mxCell id="2. -ok-80" value="Normalize response + usage&lt;br&gt;(cache-read/write tokens, cost)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="990" width="260" height="50" as="geometry"/></mxCell><mxCell id="2. -store-81" value="Write caches · emit OTel span ·&lt;br&gt;enqueue spend record (async)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="1065" width="260" height="50" as="geometry"/></mxCell><mxCell id="2. -out-82" value="Return / stream SSE" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="1140" width="260" height="50" as="geometry"/></mxCell><mxCell id="2. -e-83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -in-70" target="2. -auth-71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -auth-71" target="2. -rl-72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -rl-72" target="2. -bud-73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -bud-73" target="2. -ex-74"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -ex-74" target="2. -sem-75"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -sem-75" target="2. -plan-76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -plan-76" target="2. -cool-77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -cool-77" target="2. -call-78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-91" value="success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -call-78" target="2. -err-79"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -ok-80" target="2. -store-81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -store-81" target="2. -out-82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-94" value="no error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -err-79" target="2. -ok-80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -r429-95" value="429 Too Many Requests&lt;br&gt;(retry-after)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="245" width="120" height="44" as="geometry"/></mxCell><mxCell id="2. -e-96" value="over limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -rl-72" target="2. -r429-95"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -r402-97" value="402/429 budget exceeded&lt;br&gt;or downgrade tier (soft limit)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="345" width="200" height="50" as="geometry"/></mxCell><mxCell id="2. -e-98" value="over budget" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -bud-73" target="2. -r402-97"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -hit-99" value="Return cached response&lt;br&gt;(x-atlas-cache: exact|semantic)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="450" width="210" height="50" as="geometry"/></mxCell><mxCell id="2. -e-100" value="hit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -ex-74" target="2. -hit-99"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-101" value="hit ≥ threshold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -sem-75" target="2. -hit-99"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -retry-102" value="Retryable (429/5xx/timeout)?&lt;br&gt;backoff + jitter, honor retry-after;&lt;br&gt;record failure → maybe cooldown" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="860" width="260" height="80" as="geometry"/></mxCell><mxCell id="2. -fb-103" value="Context-window error → context fallback list&lt;br&gt;Content-policy / refusal → policy fallback list&lt;br&gt;Auth/400 → fail fast (no retry)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="960" width="300" height="70" as="geometry"/></mxCell><mxCell id="2. -e-104" value="retryable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -err-79" target="2. -retry-102"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-105" value="classified" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="2. -err-79" target="2. -fb-103"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -e-106" value="next target" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;fontSize=10;" edge="1" parent="1" source="2. -retry-102" target="2. -cool-77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -cfg-107" value="&lt;b&gt;routes.yaml&lt;/b&gt;&lt;br&gt;rag-answer:&lt;br&gt;&amp;nbsp; strategy: fallback&lt;br&gt;&amp;nbsp; targets:&lt;br&gt;&amp;nbsp;&amp;nbsp; - loadbalance: [anthropic/sonnet, openai/gpt]&lt;br&gt;&amp;nbsp;&amp;nbsp; - local/llama&lt;br&gt;&amp;nbsp; retry_policy: {RateLimit: 3, Timeout: 2}&lt;br&gt;&amp;nbsp; cooldown: {allowed_fails: 3, seconds: 30}&lt;br&gt;&amp;nbsp; cache: {exact: true, semantic: 0.95}" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="330" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="3. Ingestion Flow"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3. -title-108" value="&lt;b&gt;Ingestion: idempotent, resumable stage machine&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="3. -subtitle-109" value="Each (doc_version, stage) is keyed by content hash + pipeline_version. Re-uploading unchanged content is a no-op; changed docs re-embed only changed chunks." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="24" as="geometry"/></mxCell><mxCell id="3. -lane-API-110" value="API" style="swimlane;horizontal=1;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1500" height="130" as="geometry"/></mxCell><mxCell id="3. -lane-worker-ingest-111" value="worker-ingest" style="swimlane;horizontal=1;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1500" height="130" as="geometry"/></mxCell><mxCell id="3. -lane-worker-light-112" value="worker-light" style="swimlane;horizontal=1;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="1500" height="130" as="geometry"/></mxCell><mxCell id="3. -lane-Stores-113" value="Stores" style="swimlane;horizontal=1;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="1500" height="130" as="geometry"/></mxCell><mxCell id="3. -up-114" value="POST document&lt;br&gt;(file | URL | text)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="135" width="120" height="44" as="geometry"/></mxCell><mxCell id="3. -hash-115" value="sha256(content)&lt;br&gt;dedupe / new version" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeo